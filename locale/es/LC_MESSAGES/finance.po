msgstr "Cuando se envía una factura a JoFotara, Odoo realiza lo siguiente:"

#: ../../content/applications/finance/fiscal_localizations/jordan.rst:183
msgid "generates the invoice in the required format (UBL 1.2)"
msgstr "genera la factura en el formato requerido (UBL 1.2)"


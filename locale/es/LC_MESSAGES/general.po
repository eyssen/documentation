msgstr ":guilabel:`Título del resumen`: el nombre del correo electrónico de resumen."

#: ../../content/applications/general/companies/digest_emails.rst:54 ../../content/applications/general/companies/digest_emails.rst:195
msgid ":guilabel:`Next Mailing Date`: the date on which the digest email will be sent again."
msgstr ":guilabel:`Próxima fecha de envío`: la fecha en la que se volverá a enviar el correo electrónico de resumen."

#: ../../content/applications/general/companies/digest_emails.rst:62

#: ../../content/applications/inventory_and_mrp/inventory/warehouses_storage/reporting/locations.rst:104 ../../content/applications/inventory_and_mrp/inventory/warehouses_storage/reporting/locations.rst:138 ../../content/applications/inventory_and_mrp/inventory/warehouses_storage/reporting/locations.rst:177

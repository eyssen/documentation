msgid ":doc:`reservation_methods/at_confirmation`"
msgstr ":doc:`reservation_methods/at_confirmation`"

#: ../../content/applications/inventory_and_mrp/inventory/shipping_receiving/reservation_methods.rst:112
msgid ":doc:`reservation_methods/manually`"
msgstr ":doc:`reservation_methods/manually`"

#: ../../content/applications/inventory_and_mrp/inventory/shipping_receiving/reservation_methods.rst:113

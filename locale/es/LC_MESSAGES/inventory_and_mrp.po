msgid "Parcel machine ID and a recipient phone number."
msgstr "El identificador de la máquina de paquetería y un número de teléfono del destinatario."

#: ../../content/applications/inventory_and_mrp/inventory/shipping_receiving/setup_configuration/foxpost.rst:116
msgid "Complete shipping address and a recipient phone number."
msgstr "La dirección de envío completa y un número de teléfono del destinatario."

#: ../../content/applications/inventory_and_mrp/inventory/shipping_receiving/setup_configuration/foxpost.rst:117
msgid "Preinstalled method"
msgstr "Método preinstalado"

#: ../../content/applications/inventory_and_mrp/inventory/shipping_receiving/setup_configuration/foxpost.rst:118

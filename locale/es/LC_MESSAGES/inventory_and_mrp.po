msgstr "Todos o algunos productos recibidos. El borrador de factura ha sido creado."

#: ../../content/applications/inventory_and_mrp/purchase/manage_deals/control_bills.rst:94
msgid "Draft bill created"
msgstr "Borrador de factura creado"

#: ../../content/applications/inventory_and_mrp/purchase/manage_deals/control_bills.rst:97 ../../content/applications/inventory_and_mrp/purchase/manage_deals/rfq.rst:326

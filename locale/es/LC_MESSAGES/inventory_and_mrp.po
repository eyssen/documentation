msgid "Nothing to Bill"
msgstr "Nada a facturar"

#: ../../content/applications/inventory_and_mrp/purchase/manage_deals/control_bills.rst:87
msgid "PO confirmed; no products received"
msgstr "Orden de compra confirmada. No ha recibido los productos."

#: ../../content/applications/inventory_and_mrp/purchase/manage_deals/control_bills.rst:88
msgid "*Not applicable*"
msgstr "*No aplica*"

#: ../../content/applications/inventory_and_mrp/purchase/manage_deals/control_bills.rst:89
msgid "Waiting Bills"
msgstr "Facturas en espera"

#: ../../content/applications/inventory_and_mrp/purchase/manage_deals/control_bills.rst:90
msgid "All/some products received; bill not created"
msgstr "Todos o algunos productos recibidos. Factura sin crear."

#: ../../content/applications/inventory_and_mrp/purchase/manage_deals/control_bills.rst:91
msgid "PO confirmed"
msgstr "Orden de compra confirmada"

#: ../../content/applications/inventory_and_mrp/purchase/manage_deals/control_bills.rst:92
msgid "Fully Billed"
msgstr "Totalmente facturado"

#: ../../content/applications/inventory_and_mrp/purchase/manage_deals/control_bills.rst:93

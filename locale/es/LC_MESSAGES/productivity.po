msgstr "Administrador del sistema / de IA"

#: ../../content/applications/productivity/ai.rst:63
msgid "Providers, settings, policies, agents, monitoring"
msgstr "Proveedores, ajustes, políticas, agentes, supervisión"

#: ../../content/applications/productivity/ai.rst:65

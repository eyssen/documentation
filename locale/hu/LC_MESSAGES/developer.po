msgstr "`Kód: A switchView függvény <https://github.com/odoo/odoo/blob/db2092d8d389fdd285f54e9b34a5a99cc9523d27/addons/web/static/src/webclient/actions/action_service.js#L1064>`_"

#: ../../content/developer/tutorials/master_odoo_web_framework/02_create_gallery_view.rst:264
msgid "10. Add an optional tooltip"
msgstr "10. Opcionális tooltip hozzáadása"

#: ../../content/developer/tutorials/master_odoo_web_framework/02_create_gallery_view.rst:266
msgid "It is useful to have some additional information on mouse hover."
msgstr "Hasznos, ha van némi kiegészítő információ az egér fölé húzásakor."


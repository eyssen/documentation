msgid ":ref:`Inalterability <localizations/france/pos-inalterability>`"
msgstr ":ref:`Megváltoztathatatlanság <localizations/france/pos-inalterability>`"

#: ../../content/applications/finance/fiscal_localizations/france.rst:651
msgid ":ref:`Security <localizations/france/pos-security>`"
msgstr ":ref:`Biztonság <localizations/france/pos-security>`"

#: ../../content/applications/finance/fiscal_localizations/france.rst:652

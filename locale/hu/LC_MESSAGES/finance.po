msgid ""
"`Official Technical Specification (fr) "
"<https://www.legifrance.gouv.fr/codes/article_lc/LEGIARTI000027804775>`_"
msgstr ""
"`Hivatalos műszaki specifikáció (fr) "
"<https://www.legifrance.gouv.fr/codes/article_lc/LEGIARTI000027804775>`_"


msgstr "Szállítói visszatérítés rögzítése"

#: ../../content/applications/finance/accounting/customer_invoices/credit_notes.rst:78
msgid ""
"Vendor refunds or vendor credit notes are recorded the same way as "
":ref:`credit notes <accounting/credit_notes/issue-credit-note>`:"
msgstr ""
"A szállítói visszatérítések és szállítói jóváírások rögzítése ugyanolyan "

#: ../../content/applications/finance/fiscal_localizations/germany.rst:91
msgid "The ZIP file contains three CSV files:"
msgstr "A ZIP fájl három CSV fájlt tartalmaz:"

#: ../../content/applications/finance/fiscal_localizations/germany.rst:93
msgid ""
"the :file:`EXTF_customer_accounts.csv` file containing all information "
"related to your customers,"
msgstr ""
"a :file:`EXTF_customer_accounts.csv` fájlt, amely a vevőkre vonatkozó összes"
" információt tartalmazza,"

#: ../../content/applications/finance/fiscal_localizations/germany.rst:95
msgid ""
"the :file:`EXTF_vendor_accounts.csv` file containing all information related"
" to your vendors, and"
msgstr ""
"a :file:`EXTF_vendor_accounts.csv` fájlt, amely a szállítókra vonatkozó "

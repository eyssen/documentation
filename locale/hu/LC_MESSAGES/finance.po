msgstr "A támogatott dokumentumok:"

#: ../../content/applications/finance/fiscal_localizations/guatemala.rst:20
msgid ":guilabel:`FACT-Factura`,"
msgstr ""

#: ../../content/applications/finance/fiscal_localizations/guatemala.rst:21
msgid ":guilabel:`FCAM-Factura Cambiaria`,"
msgstr ""


msgid "`Odoo Tutorials: Internet of Things (IoT) Tutorials <https://www.odoo.com/slides/internet-of-things-iot-175>`_"
msgstr "`Odoo oktatóanyagok: Internet of Things (IoT) oktatóanyagok <https://www.odoo.com/slides/internet-of-things-iot-175>`_"

#: ../../content/applications/general/iot.rst:42
msgid "`IoT system FAQ <https://www.odoo.com/app/iot-faq>`_"
msgstr "`IoT rendszer GYIK <https://www.odoo.com/app/iot-faq>`_"

#: ../../content/applications/general/iot.rst:43
msgid "`Magic Sheet - Odoo Internet of Things [PDF] <https://drive.google.com/file/d/18D0VqlGvW6kUg-xKmyELrQqJ6J3bHKGy/view>`_"
msgstr "`Varázslap - Odoo Internet of Things [PDF] <https://drive.google.com/file/d/18D0VqlGvW6kUg-xKmyELrQqJ6J3bHKGy/view>`_"


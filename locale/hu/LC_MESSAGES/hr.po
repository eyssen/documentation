msgid "\\text{€}283.73\\text{ Total} = \\begin{cases}\n"
"+ \\text{ €148.73 (Tax, since 2021 - coronavirus)} \\\\\n"
"+ \\text{ €30 (Internet)} \\\\\n"
"+ \\text{ €25 (Phone)} \\\\\n"
"+ \\text{ €80 (Car management fees)} \\\\\n"
"\\end{cases}"

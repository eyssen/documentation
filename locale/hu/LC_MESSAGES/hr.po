msgstr "Egyéni jelenléti nyilvántartások áttekintése egy 1:1 megbeszélés során."

#: ../../content/applications/hr/attendances.rst:215
msgid "Department"
msgstr "Osztály"

#: ../../content/applications/hr/attendances.rst:216

#: ../../content/applications/inventory_and_mrp/inventory/shipping_receiving/setup_configuration/dhl_credentials.rst:94
msgid ""
"Begin by opening a `DHL Express account "
"<https://mydhl.express.dhl/gb/en/ship/open-account.html#/fs-"

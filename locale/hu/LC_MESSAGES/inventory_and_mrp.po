msgid "Serial Shipping Container Code"
msgstr "Sorozatszámú szállítókonténer-kód"

#: ../../content/applications/inventory_and_mrp/barcode/operations/gs1_nomenclature.rst:175
msgid "(00)(\\\\d{18})"
msgstr ""


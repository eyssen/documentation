#: ../../content/legal/terms/enterprise.rst:63
#: ../../content/legal/terms/i18n/enterprise_nl.rst:75
msgid "Odoo Partner"
msgstr ""

#: ../../content/legal/terms/enterprise.rst:61
msgid ""
"An Odoo Partner is a third-party company or individual, chosen by the "
"Customer, and working with the Customer for their Odoo related services. The "
"Customer can decide at any time to work with a different Odoo Partner, or to "
"work with Odoo SA directly (subject to prior notice)."
msgstr ""

msgstr "Identitás-korlátok (összefoglaló)"

#: ../../content/applications/productivity/ai/agents.rst:380
msgid "At link time the module rejects agent users that are:"
msgstr "A link időpontjában a modul elutasítja a következő ügynökfelhasználókat:"

#: ../../content/applications/productivity/ai/agents.rst:382
msgid "superuser (uid 1);"
msgstr "szuperfelhasználó (uid 1);"

#: ../../content/applications/productivity/ai/agents.rst:383
msgid "share/portal;"
msgstr "megosztás/portál;"

#: ../../content/applications/productivity/ai/agents.rst:384

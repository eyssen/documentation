#: ../../content/applications/productivity/ai/agent_recipes.rst:332
msgid "Recipe F — \"Jarvis\" default assistant for employees"
msgstr "Recept F — „Jarvis” alapértelmezett asszisztens a munkatársaknak"

#: ../../content/applications/productivity/ai/agent_recipes.rst:334
msgid "**Goal:** Everyday employee copilot in the systray."
msgstr "**Goal:** Mindennapi alkalmazott másodpilóta a rendszertálcán."

#: ../../content/applications/productivity/ai/agent_recipes.rst:336
msgid "Default agent **without** ``user_id``"
msgstr "Alapértelmezett ügynök **without** ``user_id``"

#: ../../content/applications/productivity/ai/agent_recipes.rst:337
msgid ""
"Capabilities: inherit global (ask+read); enable write only for a pilot group"

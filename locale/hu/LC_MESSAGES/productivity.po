msgid "Documents"
msgstr "Dokumentumok"

#: ../../content/applications/productivity/documents.rst:58
msgid "Folders"
msgstr "Mappák"

#: ../../content/applications/productivity/activities.rst:53 ../../content/applications/productivity/documents.rst:87
msgid "Tags"
msgstr "Címkék"


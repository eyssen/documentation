#: ../../content/applications/productivity/ai/agent_recipes.rst:327
msgid "scope_mode: N/A for pure scheduled runs owned by supervisor"
msgstr ""
"scope_mode: N/A a felügyelő tulajdonában lévő pusztán ütemezett "

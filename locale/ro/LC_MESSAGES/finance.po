msgstr "1,000"

#: ../../content/applications/finance/accounting/taxes.rst:128
#: ../../content/applications/finance/fiscal_localizations/romania/financial_statements.rst:66
#: ../../content/applications/finance/fiscal_localizations/spain/aeat_declarations.rst:372

msgstr "Setați numărul de cont pe jurnalul bancar."

#: ../../content/applications/finance/accounting/bank/statement_import.rst:148
msgid ""
"*The journal found for the file (...) is different from the selected journal "
"(...).*"
msgstr ""
"*The journal found for the file (...) is different from the selected journal "
"(...).*"

#: ../../content/applications/finance/accounting/bank/statement_import.rst:149
msgid ""
"You opened the dialog from another journal than the one of the account in "
"the file."
msgstr ""
"Ați deschis fereastra de dialog de la un alt jurnal decât cel al contului "
"din fișier."

#: ../../content/applications/finance/accounting/bank/statement_import.rst:150
msgid ""
"*The currency of the bank statement (...) is not the same as the currency of "
"the journal '...' (...).*"
msgstr ""
"*The currency of the bank statement (...) is not the same as the currency of "
"the journal '...' (...).*"

#: ../../content/applications/finance/accounting/bank/statement_import.rst:152
msgid ""
"Set the currency on the journal, or import the file into the journal of the "
"right currency."
msgstr ""
"Setați moneda pe jurnal sau importați fișierul în jurnalul cu moneda corectă."

#: ../../content/applications/finance/accounting/bank/statement_import.rst:153

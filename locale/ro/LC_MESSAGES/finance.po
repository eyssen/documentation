#: ../../content/applications/finance/accounting/bank/statement_import.rst:140
msgid ""
"*The format of this bank statement file doesn't contain the bank account "
"number, so you must start the wizard from the right bank journal in the "
"dashboard.*"
msgstr ""
"*The format of this bank statement file doesn't contain the bank account "
"number, so you must start the wizard from the right bank journal in the "
"dashboard.*"

#: ../../content/applications/finance/accounting/bank/statement_import.rst:142

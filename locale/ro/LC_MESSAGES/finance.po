msgid "Warning"
msgstr "Avertisment"

#: ../../content/applications/finance/fiscal_localizations/romania/saft_d406.rst:300
msgid "The partner has no city; `-` is reported."
msgstr "Partenerul nu are oraș; se raportează `-`."

#: ../../content/applications/finance/fiscal_localizations/romania/saft_d406.rst:301
msgid "`PAYABLE_NO_PARTNER`"
msgstr "`PAYABLE_NO_PARTNER`"


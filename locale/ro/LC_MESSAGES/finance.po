msgstr "Total"

#: ../../content/applications/finance/accounting/taxes.rst:128
#: ../../content/applications/finance/accounting/taxes.rst:144
#: ../../content/applications/finance/accounting/taxes.rst:159
#: ../../content/applications/finance/accounting/taxes.rst:337
#: ../../content/applications/finance/fiscal_localizations/india.rst:227
#: ../../content/applications/finance/fiscal_localizations/india.rst:241

#: ../../content/applications/websites/website/structure/header_footer.rst:259
msgid "Select a :guilabel:`Template`."
msgstr "Selectează un :guilabel:`Șablon`."

#: ../../content/applications/websites/website/structure/header_footer.rst:260
msgid "Choose its :guilabel:`Colors`."
msgstr "Alege :guilabel:`Culorile`."

#: ../../content/applications/websites/website/structure/header_footer.rst:261
msgid ""
"Choose a :guilabel:`Slideout Effect`: :guilabel:`Regular` (i.e., no "

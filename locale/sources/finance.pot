msgstr ""

#: ../../content/applications/finance/fiscal_localizations/spain/aeat_declarations.rst:439
msgid "2P"
msgstr ""

#: ../../content/applications/finance/fiscal_localizations/spain/aeat_declarations.rst:440
msgid "October"
msgstr ""

#: ../../content/applications/finance/fiscal_localizations/spain/aeat_declarations.rst:441

msgstr ""

#: ../../content/applications/finance/fiscal_localizations/spain.rst:377
msgid ":doc:`spain/cash_accounting`"
msgstr ""

#: ../../content/applications/finance/fiscal_localizations/spain.rst:378
msgid ":doc:`Spanish remittances per bank <../accounting/payments/spanish_remittances>`"
msgstr ""

#: ../../content/applications/finance/fiscal_localizations/spain.rst:379
msgid ":doc:`Norma 43 statement import <../accounting/bank/statement_import>` and :doc:`online bank synchronization with Enable Banking <../accounting/bank/enable_banking>`"
msgstr ""


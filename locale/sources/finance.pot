msgstr ""

#: ../../content/applications/finance/accounting/vendor_bills/assets.rst:52
msgid ":guilabel:`Analytic Account` / :guilabel:`Analytic Distribution`: the analytic distribution of the depreciation entries."
msgstr ""

#: ../../content/applications/finance/accounting/vendor_bills/assets.rst:55
msgid ":guilabel:`Periodicity` section:"
msgstr ""

#: ../../content/applications/finance/accounting/vendor_bills/assets.rst:57
msgid ":guilabel:`Time Method Based On`: :guilabel:`Number of Entries` (fixed number of depreciations and time between them) or :guilabel:`Ending Date` (time between depreciations and date after which no depreciation is computed)."
msgstr ""

#: ../../content/applications/finance/accounting/vendor_bills/assets.rst:60
msgid ":guilabel:`Number of Entries` or :guilabel:`Ending date`."
msgstr ""

#: ../../content/applications/finance/accounting/vendor_bills/assets.rst:61

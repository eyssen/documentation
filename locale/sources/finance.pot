#: ../../content/applications/finance/accounting/bank/enable_banking.rst:286
msgid "*The bank did not return an authorization code.*"
msgstr ""

#: ../../content/applications/finance/accounting/bank/enable_banking.rst:287
msgid "The consent was cancelled or refused at the bank. Click :guilabel:`Connect to bank` again."

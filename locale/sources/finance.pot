#: ../../content/applications/finance/accounting/reporting/year_end.rst:112
msgid ":guilabel:`Purchase Lock Date` — blocks vendor entries only."
msgstr ""

#: ../../content/applications/finance/accounting/reporting/year_end.rst:113

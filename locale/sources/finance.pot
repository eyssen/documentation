msgid "Date"
msgstr ""

#: ../../content/applications/finance/fiscal_localizations/spain/cash_accounting.rst:126
msgid "VAT accrued"
msgstr ""

#: ../../content/applications/finance/fiscal_localizations/spain/cash_accounting.rst:127
msgid "10 March 2025"
msgstr ""

#: ../../content/applications/finance/fiscal_localizations/spain/cash_accounting.rst:128

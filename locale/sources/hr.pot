#: ../../content/applications/hr/employees/certifications.rst:151
msgid "This :guilabel:`ADD` button **only** appears on employee profiles that already have a certification."
msgstr ""

#: ../../content/applications/hr/employees/contracts.rst:3
msgid "Contracts"
msgstr ""


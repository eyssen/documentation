#: ../../content/applications/hr/performance/reporting.rst:140
#: ../../content/applications/hr/performance/reporting.rst:142
#: ../../content/applications/hr/performance/reporting.rst:145
#: ../../content/applications/hr/performance/reporting.rst:147
msgid "Everything"
msgstr ""

#: ../../content/applications/hr/performance/confidentiality.rst:23
msgid "Their own answers to the questionnaire"
msgstr ""

#: ../../content/applications/hr/performance/confidentiality.rst:23

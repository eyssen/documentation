#: ../../content/applications/hr/fleet/extensions.rst:76
msgid "Spare parts and tyres"
msgstr ""

#: ../../content/applications/hr/fleet/extensions.rst:78
msgid "The *Fleet Parts Management* (`fleet_parts`) module identifies which products are fleet parts and which vehicle each individual part is currently fitted to."
msgstr ""

#: ../../content/applications/hr/fleet/extensions.rst:82
msgid "This module requires the *Fleet Stock Management* and *Fleet More Features* modules, and the **Inventory** application with lot and serial number tracking."
msgstr ""

#: ../../content/applications/hr/fleet/extensions.rst:86
msgid "Mark a product as a fleet part"
msgstr ""

#: ../../content/applications/hr/fleet/extensions.rst:88

msgid "Employment confirmed"
msgstr ""

#: ../../content/applications/hr/performance/probation_hu.rst:91
msgid "The trial period ends and the employment continues on unchanged terms."
msgstr ""

#: ../../content/applications/hr/performance/probation_hu.rst:91

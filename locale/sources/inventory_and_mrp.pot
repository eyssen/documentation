msgstr ""

#: ../../content/applications/inventory_and_mrp/purchase/manage_deals/rfq.rst:358
msgid "Throughout its lifecycle, a purchase order moves through the following statuses, shown at the top of the form:"
msgstr ""

#: ../../content/applications/inventory_and_mrp/purchase/manage_deals/rfq.rst:361
msgid ":guilabel:`RFQ`: the initial, unconfirmed, draft state."
msgstr ""

#: ../../content/applications/inventory_and_mrp/purchase/manage_deals/rfq.rst:362
msgid ":guilabel:`RFQ Sent`: the request for quotation has been emailed to the vendor."
msgstr ""

#: ../../content/applications/inventory_and_mrp/purchase/manage_deals/rfq.rst:363
msgid ":guilabel:`To Approve`: the order total is above the :ref:`approval threshold <purchase/manage_deals/po-approval>`, and is waiting for a manager to approve it."
msgstr ""

#: ../../content/applications/inventory_and_mrp/purchase/manage_deals/rfq.rst:365
msgid ":guilabel:`Purchase Order`: the order has been confirmed (or approved)."
msgstr ""

#: ../../content/applications/inventory_and_mrp/purchase/manage_deals/rfq.rst:366
msgid ":guilabel:`Locked`: the confirmed order can no longer be edited."
msgstr ""

#: ../../content/applications/inventory_and_mrp/purchase/manage_deals/rfq.rst:367
msgid ":guilabel:`Cancelled`: the order was cancelled."
msgstr ""

#: ../../content/applications/inventory_and_mrp/purchase/manage_deals/rfq.rst:370
msgid "Order quantity totals"

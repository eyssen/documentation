#: ../mnt/documentation/content/applications/productivity/ai/access_policy.rst:232
msgid "Field-level: allow write on the few fields set at create time (name, description, partner email, team) if your policy requires write-allow to set values on create."
msgstr ""

#: ../mnt/documentation/content/applications/productivity/ai/access_policy.rst:235
msgid "Ensure the agent **user** has matching Odoo ACLs to create those tickets — policy alone cannot grant create if the user group cannot."
msgstr ""

#: ../mnt/documentation/content/applications/productivity/ai/access_policy.rst:239
msgid "Calendar free/busy without event details"
msgstr ""

#: ../mnt/documentation/content/applications/productivity/ai/access_policy.rst:241
msgid "Goal: agent may create a meeting in free slots but must not dump other people's event subjects and attendees to the LLM."
msgstr ""

#: ../mnt/documentation/content/applications/productivity/ai/access_policy.rst:244
#: ../mnt/documentation/content/applications/productivity/ai/agent_recipes.rst:152

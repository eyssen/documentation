msgstr ""

#: ../mnt/documentation/content/applications/productivity/ai/agent_recipes.rst:93
msgid "**Goal:** A public or portal-facing assistant that:"
msgstr ""

#: ../mnt/documentation/content/applications/productivity/ai/agent_recipes.rst:95
msgid "answers from **productised Odoo knowledge** and public help content;"
msgstr ""

#: ../mnt/documentation/content/applications/productivity/ai/agent_recipes.rst:96

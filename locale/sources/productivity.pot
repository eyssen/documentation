msgstr ""

#: ../../content/applications/productivity/ai/access_policy.rst:20
msgid "An ``ai.access.group`` is a set of people the rules apply to:"
msgstr ""

#: ../../content/applications/productivity/ai/access_policy.rst:22
msgid ":guilabel:`Members` — explicit users (including agent users)."

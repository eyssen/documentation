#: ../../content/applications/sales/subscriptions/lines.rst:81
msgid "Pricing tiers"
msgstr ""

#: ../../content/applications/sales/subscriptions/lines.rst:83
msgid "For a :guilabel:`Tiered` line, add brackets in the :guilabel:`Pricing Tiers` tab: :guilabel:`Min Qty`, :guilabel:`Max Qty` (exclusive; leave `0` for the open-ended top bracket) and :guilabel:`Unit Price`. The :guilabel:`Mode` field decides how they are combined:"
msgstr ""


#: ../../content/applications/sales/sales/commissions.rst:200
msgid "Deal salesperson"
msgstr ""

#: ../../content/applications/sales/sales/commissions.rst:202
msgid "The commission is credited to the :guilabel:`Deal Salesperson` of the invoice, not to whoever happens to be the salesperson at payout time."

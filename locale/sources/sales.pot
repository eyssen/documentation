msgstr ""

#: ../../content/applications/sales/subscriptions/lines.rst:10
msgid "Basic fields"
msgstr ""

#: ../../content/applications/sales/subscriptions/lines.rst:12
msgid ":guilabel:`Description`: the label of the line."
msgstr ""

#: ../../content/applications/sales/subscriptions/lines.rst:13
msgid ":guilabel:`Product`: only products flagged as :doc:`subscription products <products>` are offered."
msgstr ""

#: ../../content/applications/sales/subscriptions/lines.rst:14
msgid ":guilabel:`Service Address`: an address of the customer (or one of its child contacts) where the service is delivered. Optional."
msgstr ""

#: ../../content/applications/sales/subscriptions/lines.rst:16
msgid ":guilabel:`Start Date`: the first day the line covers. Required — every period is derived from it."
msgstr ""

#: ../../content/applications/sales/subscriptions/lines.rst:17
msgid ":guilabel:`Contract End`: the hard upper bound of automatic renewal. Once the billed periods reach this date, no further invoice is generated. Leave it empty for an open-ended subscription."
msgstr ""

#: ../../content/applications/sales/subscriptions/lines.rst:19
msgid ":guilabel:`Auto-renew`: when disabled, billing stops after the first period."
msgstr ""

#: ../../content/applications/sales/subscriptions/lines.rst:20
msgid ":guilabel:`UoM`, :guilabel:`Discount`, :guilabel:`Payment Term`: as on an ordinary invoice line."
msgstr ""

#: ../../content/applications/sales/subscriptions/lines.rst:21
msgid ":guilabel:`Invoice Note`: overrides the invoice line label. The placeholders `#START#`, `#END#` and `#PERIOD#` are replaced with the billed period."
msgstr ""

#: ../../content/applications/sales/subscriptions/lines.rst:24
msgid "Read-only fields show where the line stands: :guilabel:`Paid Until` (the last day covered by a posted invoice), :guilabel:`Next Period Start` and :guilabel:`Next Period End`, :guilabel:`Last Invoice` and :guilabel:`Next Invoice`."
msgstr ""

#: ../../content/applications/sales/subscriptions/lines.rst:37
msgid "Line states"
msgstr ""

#: ../../content/applications/sales/subscriptions/lines.rst:39
msgid "A line has the same five states as the contract: :guilabel:`Draft`, :guilabel:`Active`, :guilabel:`Inactive`, :guilabel:`Expired` and :guilabel:`Closed`. The header buttons are :guilabel:`Activate`, :guilabel:`Pause` and :guilabel:`Close`. Only :guilabel:`Active` lines are invoiced."
msgstr ""

#: ../../content/applications/sales/subscriptions/lines.rst:47
msgid "Pausing and resuming"
msgstr ""

#: ../../content/applications/sales/subscriptions/lines.rst:49
msgid "Pausing a line stops billing. When it is activated again, a :guilabel:`Billing Resumes On` date is set: periods that ended before that date are **not** billed retroactively. A subscription paused for six months therefore does not produce six invoices when it comes back."
msgstr ""

#: ../../content/applications/sales/subscriptions/lines.rst:56
msgid "The :guilabel:`Pricing Model` field decides how the invoiced amount is computed:"
msgstr ""

#: ../../content/applications/sales/subscriptions/lines.rst:62
msgid "Pricing model"
msgstr ""

#: ../../content/applications/sales/subscriptions/lines.rst:64
msgid ":guilabel:`Flat fee`"
msgstr ""

#: ../../content/applications/sales/subscriptions/lines.rst:65
msgid "The agreed :guilabel:`Quantity` × :guilabel:`Unit price`."
msgstr ""

#: ../../content/applications/sales/subscriptions/lines.rst:66
msgid ":guilabel:`Per seat`"
msgstr ""

#: ../../content/applications/sales/subscriptions/lines.rst:67
msgid "The quantity comes from a seat source instead of the fixed quantity."
msgstr ""

#: ../../content/applications/sales/subscriptions/lines.rst:68
msgid ":guilabel:`Usage-based`"
msgstr ""

#: ../../content/applications/sales/subscriptions/lines.rst:69
msgid "The quantity comes from measured usage for the billed period."
msgstr ""

#: ../../content/applications/sales/subscriptions/lines.rst:70
msgid ":guilabel:`Tiered`"
msgstr ""

